{
  "name": "Course Explorer",
  "slug": "AppTechTest2627",
  "scheme": "apptechtest2627",
  "version": "1.0.0",
  "orientation": "default",
  "userInterfaceStyle": "automatic",
  "icon": "./assets/images/ust-course-explorer-icon.png",
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "newArchEnabled": true,
  "jsEngine": "hermes",
  "assetBundlePatterns": [
    "**/*"
  ],
  "android": {
    "icon": "./assets/images/ust-course-explorer-icon.png",
    "package": "com.usthing.apptechtest27",
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/ust-course-explorer-adaptive-foreground-safe.png",
      "backgroundColor": "#062F5F"
    },
    "allowBackup": false,
    "edgeToEdgeEnabled": true
  },
  "ios": {
    "icon": "./assets/images/ust-course-explorer-icon.png",
    "supportsTablet": true,
    "bundleIdentifier": "com.usthing.apptechtest27"
  },
  "web": {
    "favicon": "./assets/images/ust-course-explorer-favicon.png",
    "bundler": "metro"
  },
  "plugins": [
    "expo-font",
    [
      "expo-screen-orientation",
      {
        "initialOrientation": "PORTRAIT_UP"
      }
    ],
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/ust-course-explorer-adaptive-foreground.png",
        "imageWidth": 300,
        "resizeMode": "contain",
        "backgroundColor": "#062F5F"
      }
    ],
    [
      "react-native-edge-to-edge",
      {
        "android": {
          "parentTheme": "Light",
          "enforceNavigationBarContrast": false
        }
      }
    ],
    "expo-build-properties"
  ],
  "experiments": {
    "tsconfigPaths": true
  },
  "extra": {
    "ignite": {
      "version": "11.5.0"
    }
  }
}
